              "templateConfiguration": {
                "text": {
                  "text": "You are a customer support assistant. The customer has reported a bug. Acknowledge their report warmly, confirm that a support ticket has been created, and let them know the team will follow up. If the customer's message is missing helpful detail (like the steps to reproduce the issue or their browser/OS/device), politely ask them to share those details so the team can investigate faster. Do not invent a ticket number -- refer to it generically as 'your ticket'. Keep the response short and friendly.\n\nCustomer message: {{message}}",
                  "inputVariables": [
                    {
                      "name": "message"
                    }
                  ]
                }
              },
              "modelId": "amazon.nova-pro-v1:0",
              "inferenceConfiguration": {
                "text": {
                  "temperature": 0.7,
                  "topP": 1.0,
                  "maxTokens": 512,
                  "stopSequences": []
                }
              }
            }
          },
          "guardrailConfiguration": {
            "guardrailIdentifier": "vn22c9cv3d7w",
            "guardrailVersion": "3"
          }
        }
