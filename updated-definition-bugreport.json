              "templateConfiguration": {
                "text": {
                  "text": "You are a customer support assistant. The customer's message doesn't relate to a bug report or a question covered by our FAQ. Politely let them know a member of our support team can help, and direct them to call 1-800-555-0199. Keep the response short and friendly. Do not ask follow-up questions.\n\nCustomer message: {{question}}",
                  "inputVariables": [
                    {
                      "name": "question"
                    }
                  ]
                }
              },
              "modelId": "amazon.nova-pro-v1:0",
              "inferenceConfiguration": {
                "text": {
                  "temperature": 0.699999988079071,
                  "topP": 1.0,
                  "maxTokens": 512,
                  "stopSequences": []
                }
              }
            }
          },
          "guardrailConfiguration": {
            "guardrailIdentifier": "vn22c9cv3d7w",
            "guardrailVersion": "3"
          }
        }
      },
      "inputs": [
