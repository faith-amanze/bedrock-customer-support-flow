    {
      "name": "ClassifierPrompt",
      "type": "Prompt",
      "configuration": {
        "prompt": {
          "sourceConfiguration": {
            "inline": {
              "templateType": "TEXT",
              "templateConfiguration": {
                "text": {
                  "text": "You are a message classifier for a customer support chatbot. Classify the customer's message into exactly one category.\n\nCategories:\n- BUG_REPORT: the customer is reporting a problem, error, or something not working correctly on the platform\n- PLATFORM_QUESTION: the customer is asking about orders, shipping, returns, payments, or how the platform works\n- OTHER_REQUEST: the message doesn't clearly fit either category above\n\nCustomer message: {{topic}}\n\nRespond with ONLY the category name and absolutely nothing else. Do not explain your reasoning. Do not add punctuation. Do not add any other words. Your entire response must be exactly one of: BUG_REPORT, PLATFORM_QUESTION, OTHER_REQUEST",
                  "inputVariables": [
                    {
                      "name": "topic"
                    }
                  ]
                }
              },
              "modelId": "amazon.nova-pro-v1:0",
              "inferenceConfiguration": {
                "text": {
                  "temperature": 0.699999988079071,
                  "topP": 1.0,
                  "maxTokens": 512,
                  "stopSequences": []
                }
              }
            }
          },
          "guardrailConfiguration": {
            "guardrailIdentifier": "vn22c9cv3d7w",
            "guardrailVersion": "3"
          }
        }
      },
      "inputs": [
        {
          "name": "topic",
          "type": "String",
          "expression": "$.data"
        }
      ],
      "outputs": [
        {
          "name": "modelCompletion",
          "type": "String"
        }
      ]
    },
    {
