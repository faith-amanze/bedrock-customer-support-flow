              "templateConfiguration": {
                "text": {
                  "text": "You are a customer support assistant for an online shop. Below are retrieved FAQ excerpts that may or may not be relevant to the customer's question. If the excerpts clearly answer the question, give a clear, friendly answer based on them. If they don't contain a relevant answer, do not guess -- respond with exactly: \"I'm sorry, I don't have information on that. Please call our support line at 1-800-555-0199 for further help.\"\n\nRetrieved excerpts:\n{{excerpts}}\n\nCustomer question: {{question}}",
                  "inputVariables": [
                    {
                      "name": "excerpts"
                    },
                    {
                      "name": "question"
                    }
                  ]
                }
              },
              "modelId": "amazon.nova-pro-v1:0",
              "inferenceConfiguration": {
                "text": {
                  "temperature": 0.699999988079071,
                  "topP": 1.0,
                  "maxTokens": 512,
                  "stopSequences": []
                }
              }
            }
          },
          "guardrailConfiguration": {
            "guardrailIdentifier": "vn22c9cv3d7w",
            "guardrailVersion": "3"
          }
        }
      },
      "inputs": [
        {
          "name": "excerpts",
          "type": "Array",
          "expression": "$.data"
